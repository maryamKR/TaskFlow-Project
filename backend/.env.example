PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/dbname
JWT_SECRET=your_jwt_secret_key_here
GEMINI_API_KEY=your_gemini_api_key

# Email (Brevo) — required for board invites and password reset
# Using Brevo API to bypass SMTP restrictions in some hosting environments
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=notifications@domain.com
BREVO_SENDER_NAME=sendername

FRONTEND_URL=http://localhost:3000

# Allowed origins for CORS and CSP (comma-separated, no trailing slashes)
# In production, set this to the actual frontend URL(s)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
